{
  "name": "cpr-gestion",
  "version": "1.1.0",
  "private": true,
  "description": "Gestion CPR SASU — Windows, Android, PWA",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "dev": "npm run build:web && npx serve www",
    "desktop": "npm run build:web && electron .",
    "build:windows": "npm run build:web && electron-builder --win nsis --x64",
    "android:add": "npm run build:web && cap add android && npm run android:prepare && cap sync android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "serve": "^14.0.0"
  },
  "build": {
    "appId": "fr.cpr.gestion",
    "productName": "CPR Gestion",
    "directories": {
      "output": "release-windows"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "assets/icon-512.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "CPR-Gestion-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  }
}